{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/admin-session.js": {
      "maxDuration": 15
    },
    "api/assist.js": {
      "maxDuration": 60
    },
    "api/guide.js": {
      "maxDuration": 60
    },
    "api/workshop.js": {
      "maxDuration": 60
    },
    "api/credits.js": {
      "maxDuration": 60
    },
    "api/payments.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/access.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
